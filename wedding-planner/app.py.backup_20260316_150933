@app.route('/tasks/import-template', methods=['POST'])
def import_template():
    """从内置模板导入任务"""
    phase = request.form.get('phase')
    wedding_date_str = request.form.get('wedding_date') or request.args.get('wedding_date')
    
    if phase not in WEDDING_CHECKLIST:
        flash('无效的阶段', 'error')
        return redirect(url_for('tasks'))
    
    # 获取婚礼日期
    db = get_db()
    if wedding_date_str:
        try:
            wedding_date = datetime.strptime(wedding_date_str, '%Y-%m-%d').date()
        except:
            flash('婚礼日期格式错误', 'error')
            return redirect(url_for('tasks'))
    else:
        wedding_date_row = db.execute(
            "SELECT value FROM settings WHERE key='wedding_date'"
        ).fetchone()
        if wedding_date_row:
            try:
                wedding_date = datetime.strptime(wedding_date_row[0], '%Y-%m-%d').date()
            except:
                wedding_date = None
        else:
            wedding_date = None
    
    if not wedding_date:
        flash('请先设置婚礼日期，或在上方选择婚礼日期后再导入模板', 'error')
        return redirect(url_for('tasks'))
    
    # 导入模板任务
    count = 0
    for task_template in WEDDING_CHECKLIST[phase]:
        days_before = task_template.get('days_before', 0)
        due_date = wedding_date + timedelta(days=days_before)
        
        # 检查是否已存在相同reference的任务
        existing = db.execute(
            'SELECT id FROM tasks WHERE reference_id=? AND phase=?',
            (task_template['id'], phase)
        ).fetchone()
        
        if not existing:
            db.execute('''
                INSERT INTO tasks (title, description, category, phase, due_date, priority, reference_id)
                VALUES (?, ?, ?, ?, ?, ?, ?)
            ''', (
                task_template['title'],
                task_template.get('description', ''),
                task_template.get('category', '通用'),
                phase,
                due_date.isoformat(),
                task_template.get('priority', 'medium'),
                task_template['id']
            ))
            count += 1
    
    db.commit()
    flash(f'已从模板导入 {count} 个任务到「{phase}」阶段', 'success')
    return redirect(url_for('tasks'))

