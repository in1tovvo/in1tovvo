@app.route('/')
def dashboard():
    db = get_db()
    total_tasks = db.execute('SELECT COUNT(*) FROM tasks').fetchone()[0]
    completed_tasks = db.execute("SELECT COUNT(*) FROM tasks WHERE status='completed'").fetchone()[0]
    
    # 待办任务（按优先级分类）
    urgent_tasks_raw = db.execute("""
        SELECT * FROM tasks 
        WHERE status != 'completed' 
        AND priority = 'critical' 
        AND due_date <= date('now', '+7 days')
        ORDER BY due_date ASC LIMIT 5
    """).fetchall()
    
    # 转换为字典并处理日期
    urgent_tasks = []
    for task in urgent_tasks_raw:
        task_dict = dict(task)
        if task_dict['due_date']:
            try:
                task_dict['due_date'] = datetime.strptime(task_dict['due_date'], '%Y-%m-%d').date()
            except:
                pass
        urgent_tasks.append(task_dict)
    
    # 即将到期任务
    upcoming_raw = db.execute('''
        SELECT * FROM tasks 
        WHERE status != 'completed' 
        AND due_date <= date('now', '+7 days')
        AND priority != 'critical'
        ORDER BY due_date ASC LIMIT 5
    ''').fetchall()
    
    upcoming = []
    for task in upcoming_raw:
        task_dict = dict(task)
        if task_dict['due_date']:
            try:
                task_dict['due_date'] = datetime.strptime(task_dict['due_date'], '%Y-%m-%d').date()
            except:
                pass
        upcoming.append(task_dict)
    
    # 按分类统计
    task_stats_raw = db.execute('''
        SELECT category, status, COUNT(*) as count 
        FROM tasks 
        GROUP BY category, status
        ORDER BY category, status
    ''').fetchall()
    
    # 整理统计数据（转换为列表，便于前端JSON序列化）
    stats_by_cat = {}
    for row in task_stats_raw:
        cat = row['category'] or '未分类'
        if cat not in stats_by_cat:
            stats_by_cat[cat] = {'total': 0, 'completed': 0}
        stats_by_cat[cat]['total'] += row['count']
        if row['status'] == 'completed':
            stats_by_cat[cat]['completed'] += row['count']
    
    task_stats_list = []
    for cat, data in stats_by_cat.items():
        task_stats_list.append({
            'category': cat,
            'total': data['total'],
            'completed': data['completed']
        })
    
    # 计算需要的任务数
    needed_tasks = db.execute('SELECT COUNT(*) FROM tasks WHERE is_needed = 1').fetchone()[0] or 0
    
    return render_template('dashboard.html',
                         total_tasks=total_tasks,
                         completed_tasks=completed_tasks,
                         needed_tasks=needed_tasks,
                         urgent_tasks=urgent_tasks,
                         upcoming=upcoming,
                         task_stats=task_stats_list)

@app.route('/tasks')
def tasks():
    db = get_db()
    
    # 筛选参数
    phase = request.args.get('phase')
    category = request.args.get('category')
    status = request.args.get('status')
    priority = request.args.get('priority')
    
    query = 'SELECT * FROM tasks WHERE 1=1'
    params = []
    
    if phase:
        query += ' AND phase=?'
        params.append(phase)
    if category:
        query += ' AND category=?'
        params.append(category)
    if status:
        query += ' AND status=?'
        params.append(status)
    if priority:
        query += ' AND priority=?'
        params.append(priority)
    
    query += ' ORDER BY CASE WHEN due_date IS NULL THEN 1 ELSE 0 END, due_date ASC, priority DESC'
    tasks_raw = db.execute(query, params).fetchall()
    
    # 将 Row 对象转换为字典并处理日期
    tasks_list = []
    for task in tasks_raw:
        task_dict = dict(task)
        # 将 due_date 字符串转换为 date 对象，避免模板中比较错误
        if task_dict['due_date']:
            try:
                task_dict['due_date'] = datetime.strptime(task_dict['due_date'], '%Y-%m-%d').date()
            except:
                pass  # 保持原值
        tasks_list.append(task_dict)
    
    # 获取所有阶段（从 WEDDING_CHECKLIST）
    phases = list(WEDDING_CHECKLIST.keys())
    
    # 获取已使用的分类
    used_categories = db.execute(
        'SELECT DISTINCT category FROM tasks WHERE category IS NOT NULL'
    ).fetchall()
    categories = [row['category'] for row in used_categories]
    
    # 计算需要的任务数
    needed_tasks = db.execute('SELECT COUNT(*) FROM tasks WHERE is_needed = 1').fetchone()[0] or 0
    completed_tasks = db.execute("SELECT COUNT(*) FROM tasks WHERE status='completed'").fetchone()[0] or 0
    
    return render_template('tasks.html', 
                         tasks=tasks_list, 
                         phases=phases,
                         categories=categories,
                         needed_tasks=needed_tasks,
                         completed_tasks=completed_tasks,
                         selected_phase=phase,
                         selected_category=category,
                         selected_status=status,
                         selected_priority=priority)

@app.route('/tasks/<int:task_id>/toggle-needed', methods=['POST'])
def toggle_needed(task_id):
    """切换任务的 is_needed 状态"""
    db = get_db()
    
    # 获取任务
    task = db.execute('SELECT * FROM tasks WHERE id = ?', (task_id,)).fetchone()
    if not task:
        return jsonify({'success': False, 'error': '任务不存在'}), 404
    
    # 解析JSON请求
    data = request.get_json()
    if not data or 'is_needed' not in data:
        return jsonify({'success': False, 'error': '缺少参数'}), 400
    
    is_needed = 1 if data['is_needed'] else 0
    
    # 更新
    db.execute('UPDATE tasks SET is_needed = ? WHERE id = ?', (is_needed, task_id))
    db.commit()
    
    return jsonify({'success': True})

