    }

# ==================== 数据库初始化 ====================

def init_db():
    with app.app_context():
        db = get_db()
        # settings表
        db.execute('CREATE TABLE IF NOT EXISTS settings (key TEXT PRIMARY KEY, value TEXT)')
        db.execute('INSERT OR IGNORE INTO settings (key, value) VALUES (?, ?)', 
                   ('wedding_date', (date.today() + timedelta(days=365)).isoformat()))
        
        # 任务表（支持内置reference）
        db.execute('''
            CREATE TABLE IF NOT EXISTS tasks (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                description TEXT,
                category TEXT,
                phase TEXT,
                due_date DATE,
                assigned_to TEXT,
                status TEXT DEFAULT 'pending',
                priority TEXT DEFAULT 'medium',
                reference_id TEXT,  -- 关联内置事项ID
                dependencies TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
                completed_at TIMESTAMP
            )
        ''')
        
        # 预算表（保持不变）
        db.execute('''
            CREATE TABLE IF NOT EXISTS budget (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                category TEXT NOT NULL,
                item_name TEXT NOT NULL,
                estimated_cost REAL,
                actual_cost REAL,
                deposit REAL DEFAULT 0,
                balance REAL DEFAULT 0,
                vendor TEXT,
                vendor_contact TEXT,
                contract_file TEXT,
                status TEXT DEFAULT 'pending',
                notes TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        # 宾客表
        db.execute('''
            CREATE TABLE IF NOT EXISTS guests (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                phone TEXT,
                email TEXT,
                relationship TEXT,
                side TEXT CHECK(side IN ('bride', 'groom', 'both')),
                table_number INTEGER,
                invitation_status TEXT DEFAULT 'pending',
                rsvp_status TEXT DEFAULT 'no_response',
                plus_one BOOLEAN DEFAULT 0,
                dietary_restrictions TEXT,
                gift_amount REAL,
                notes TEXT
            )
        ''')
        
        # 供应商表
        db.execute('''
            CREATE TABLE IF NOT EXISTS vendors (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                name TEXT NOT NULL,
                category TEXT NOT NULL,
                contact_person TEXT,
                phone TEXT,
                email TEXT,
                address TEXT,
                price_range TEXT,
                rating REAL,
                notes TEXT,
                contract_date DATE,
                contract_file TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        # 灵感板表
        db.execute('''
            CREATE TABLE IF NOT EXISTS moodboard (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                title TEXT NOT NULL,
                category TEXT,
                image_url TEXT,
                tags TEXT,
                notes TEXT,
                created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        ''')
        
        # 桌席安排表
        db.execute('''
            CREATE TABLE IF NOT EXISTS tables (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                table_number INTEGER NOT NULL,
                table_name TEXT,
                shape TEXT DEFAULT 'round',
                capacity INTEGER DEFAULT 10,
                x_coordinate REAL,
                y_coordinate REAL,
                notes TEXT
            )
        ''')
        
        db.execute('''
            CREATE TABLE IF NOT EXISTS guest_tables (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                guest_id INTEGER NOT NULL,
                table_id INTEGER NOT NULL,
                seat_number INTEGER,
                notes TEXT,
                FOREIGN KEY (guest_id) REFERENCES guests (id) ON DELETE CASCADE,
                FOREIGN KEY (table_id) REFERENCES tables (id) ON DELETE CASCADE,
                UNIQUE(guest_id, table_id, seat_number)
            )
        ''')
        
        db.commit()

